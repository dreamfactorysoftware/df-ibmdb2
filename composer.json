{
  "name":        "dreamfactory/df-ibmdb2",
  "description": "The DreamFactory(tm) IBM DB2 Service.",
  "keywords":    [
    "dreamfactory",
    "api",
    "rest",
    "ibm db2",
    "sql",
    "database",
    "db"
  ],
  "homepage":    "https://www.dreamfactory.com/",
  "license":     "proprietary",
  "authors":     [
    {
      "name":  "Arif Islam",
      "email": "arifislam@dreamfactory.com"
    },
    {
      "name":  "Lee Hicks",
      "email": "leehicks@dreamfactory.com"
    }
  ],
  "support":     {
    "email":  "dspsupport@dreamfactory.com",
    "source": "https://github.com/dreamfactorysoftware/df-ibmdb2",
    "issues": "https://github.com/dreamfactorysoftware/df-ibmdb2/issues",
    "wiki":   "https://wiki.dreamfactory.com"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require":     {
    "php": "^8.3",
    "laravel/helpers": "^1.8",
    "dreamfactory/df-sqldb": "~1.4"
  },
  "require-dev": {
    "laravel/framework": "^13.7",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5.3",
    "orchestra/testbench": "^11.0"
  },
  "autoload":    {
    "psr-4": {
      "DreamFactory\\Core\\IbmDb2\\": "src/"
    }
  },
  "extra":       {
    "branch-alias": {
      "dev-develop": "0.15.x-dev"
    },
    "laravel": {
      "providers": [
        "DreamFactory\\Core\\IbmDb2\\ServiceProvider"
      ]
    }
  }
